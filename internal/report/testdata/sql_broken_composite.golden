-- Step 1 — look at what is orphaned.
SELECT c."nota_empresa_id", c."nota_numero", count(*) AS orphan_rows
FROM "public"."rateio" AS c
WHERE c."nota_empresa_id" IS NOT NULL
  AND c."nota_numero" IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM "public"."nota" AS p WHERE p."empresa_id" = c."nota_empresa_id" AND p."numero" = c."nota_numero")
GROUP BY 1, 2
ORDER BY 3 DESC;

