-- A NOT VALID constraint blocks new violations but never checked the rows
-- that were already there. It renders as an ordinary foreign key in \d and
-- in every ERD tool, which is what makes it worth finding.
--
-- Running VALIDATE blindly on a table with historical violations fails only
-- after a full scan, so the check comes first.

-- public.item — constraint "item_composto_fkey" references public.produto
-- Step 1 — would it pass?
SELECT count(*) AS violating_rows
FROM "public"."item" AS c
WHERE c."empresa_id" IS NOT NULL
  AND c."produto_id" IS NOT NULL
  AND NOT EXISTS (SELECT 1 FROM "public"."produto" AS p WHERE p."empresa_id" = c."empresa_id" AND p."id" = c."produto_id");

-- Step 2 — if step 1 returns zero, validate. It scans the table under a
-- lock that blocks neither reads nor writes.
-- ALTER TABLE "public"."item" VALIDATE CONSTRAINT "item_composto_fkey";

